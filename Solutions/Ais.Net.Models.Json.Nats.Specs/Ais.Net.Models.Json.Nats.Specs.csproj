<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CS1591: XML doc comments are not required in the test project. -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="$(ContinuousIntegrationBuild) == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <!-- Integration test: real NATS server in a container, and the NATS client to talk to it. -->
    <PackageReference Include="Testcontainers.Nats" />
    <PackageReference Include="NATS.Client.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.Models.Json.Nats\Ais.Net.Models.Json.Nats.csproj" />
  </ItemGroup>

</Project>
